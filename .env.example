# --- Google Drive folders -------------------------------------------------
# The ID is the last part of the folder URL: drive.google.com/drive/folders/<ID>
GOOGLE_DRIVE_RECEIPTS_FOLDER_ID=
GOOGLE_DRIVE_INVOICES_FOLDER_ID=

# --- Google credentials: pick ONE of the two options ----------------------
# Option A: service account. The folders must live in a Shared Drive that the
# service account is a member of (service accounts have no storage quota in
# a personal "My Drive"). Paste the key JSON on one line, or base64-encode it.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option B: act as a real Google user (works with a personal My Drive).
# Create an OAuth client (type "Desktop app"), then run `npm run google-token`.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# If none of the above is set, files are written to ./.local-drive instead
# (development only).

# --- App ------------------------------------------------------------------
# Timezone used for the dates in file names (IANA name). Defaults to the
# server's timezone.
APP_TIMEZONE=

# Staff password for every page except invoice share links. Leave empty to
# turn the gate off (local development).
STAFF_PASSWORD=
# Vercel only: secret the daily cron job sends to /api/cron/cleanup.
CRON_SECRET=

# --- Production (node build) ----------------------------------------------
# Public URL of the app; required behind a reverse proxy.
ORIGIN=
# Max request size. The default (512K) is too small for receipt photos.
BODY_SIZE_LIMIT=30M
PORT=3000
